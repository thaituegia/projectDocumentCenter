# Node.js 24+; optional: node --env-file=.env server/index.js
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.data
STORAGE_DRIVER=local
# R2 must remain private; use a separate development bucket.
# STORAGE_DRIVER=r2
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=bacnhabook-development
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# HTTPS email provider endpoint compatible with {from,to,subject,text}.
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=
# EMAIL_FROM=Bacnhabook <documents@your-domain.vn>
# Required in production: base64-encoded 32 random bytes from your secret manager.
# EMAIL_OUTBOX_KEY=
# Fail-closed: no upload is released without a working scanner.
# CLAMSCAN_PATH=/usr/bin/clamscan
# PDFTOTEXT_PATH=/usr/bin/pdftotext
# LIBREOFFICE_PATH=/usr/bin/libreoffice
# Technical dev limit, not an agreed business limit.
UPLOAD_MAX_BYTES=104857600
# Must be outside DATA_DIR. Local rehearsal is not an independent off-site backup.
# BACKUP_DIR=/workspace/bacnhabook-backups
